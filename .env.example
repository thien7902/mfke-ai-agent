# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=telegram_bot

# Admin User IDs (comma-separated)
ADMIN_USER_IDS=123456789,987654321

# AI Provider Configuration (choose one)
# Option 1: Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: OpenAI / Custom OpenAI-compatible endpoint
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1  # Change for custom endpoints (e.g., Azure, local LLM)
OPENAI_MODEL=gpt-4o  # Model name

# Holmes Configuration
HOLMES_CONFIG_PATH=/root/.holmes/config.yaml

# Enterprise model for /claude (admin-only one-shot command). Value is a key
# from ~/.holmes/model_list.yaml (Holmes resolves it to api_base + api_key, so
# no credentials are duplicated here). Leave unset to disable /claude.
CLAUDE_ENTERPRISE_MODEL=openai/claude-sonnet-5

# /claude reads uploaded images natively by default: attach a screenshot with
# `/claude <prompt>` as its caption, or reply to an image with `/claude <prompt>`.
# The bytes go straight in as image_url content blocks — no OCR, and this is
# INDEPENDENT of MAIN_MODEL_SUPPORTS_IMAGES (which governs the default model's
# path in handle_file). Set to false only if the enterprise endpoint is
# text-only; /claude then skips attaching images.
ENTERPRISE_MODEL_SUPPORTS_IMAGES=true

# Additional system prompt additions for HolmesGPT (optional)
# This will be appended to the default Holmes system prompt.
# Instruct the LLM to emit a short text update after each tool call so the
# user can see progress via /ping (Holmes only streams AI_MESSAGE when the
# LLM writes content — tool-only iterations are otherwise silent).
# Example: HOLMES_SYSTEM_PROMPT_ADDITIONS="You are a helpful assistant specialized in DevOps tasks."
HOLMES_SYSTEM_PROMPT_ADDITIONS="After each tool call you make, ALWAYS write a 1-2 sentence note to the user describing what you just did and what you will do next, before continuing with further tool calls. Keep it concise."

# Logging
LOG_LEVEL=INFO

# Rate Limiting (requests per minute per user)
RATE_LIMIT_PER_MINUTE=30

# Permission Request Expiry (minutes)
PERMISSION_REQUEST_EXPIRY_MINUTES=10

# Message batching (per forum topic). Rapid consecutive messages in a topic are
# combined into a single Holmes request after the quiet period elapses.
MESSAGE_BATCH_QUIET_PERIOD_SECONDS=10   # flush N seconds after the last message in the topic
MESSAGE_BATCH_MAX_WAIT_SECONDS=30      # hard cap so a chatty topic still flushes
MESSAGE_BATCH_MAX_MESSAGES=20           # flush early once this many messages accumulate

# Graph Memory (Graphiti + FalkorDB). Enabled by default — MemoryService
# init is wrapped in try/except so a FalkorDB/embedder failure only disables
# memory, not the whole bot. Set to false to opt out entirely.
#
# Memory is exposed as the `search_memory` Holmes tool. A rule appended to
# HOLMES_SYSTEM_PROMPT_ADDITIONS (automatic when memory is enabled) tells
# Holmes to call search_memory ONLY after at least one investigative tool
# has produced concrete signals (pod names, errors, service names, ...).
# This avoids irrelevant retrievals on generic questions like "check the
# cluster"; Holmes first runs kubectl/logs/etc., then queries memory with
# distilled concrete signals.
#
# Embedder shares OPENAI_API_BASE/OPENAI_API_KEY with Holmes LLM and the
# vision/OCR service. If Holmes uses Anthropic (no OPENAI_API_KEY), you
# must set those two env vars separately for embedder + vision to work.
GRAPHITI_MEMORY_ENABLED=true

# FalkorDB backend mode:
#   - "embedded": in-process falkordblite (no Docker). Requires Python 3.12+.
#                 Path is on-disk and survives restarts. Default.
#   - "server":   separate FalkorDB container. Set HOST/PORT to point at it.
GRAPHITI_FALKOR_MODE=embedded
GRAPHITI_DB_PATH=/root/.holmes/graphiti.db
GRAPHITI_FALKOR_HOST=localhost
GRAPHITI_FALKOR_PORT=6379
GRAPHITI_FALKOR_DATABASE=default_db

# Group id used for ingested episodes. All global knowledge shares one group
# so search is cross-conversation. Change to segregate.
GRAPHITI_GROUP_ID=global

# Embedder: served at OPENAI_API_BASE with OPENAI_API_KEY (same endpoint as
# Holmes). Vietnamese_Embedding (aiteamvn/vietnamese-embedding) produces
# 1024-dim vectors.
GRAPHITI_EMBEDDING_MODEL=Vietnamese_Embedding
GRAPHITI_EMBEDDING_DIM=1024

# Background consolidator — Hermes-style chat-distilled knowledge capture.
# After a forum topic has been idle for CONSOLIDATOR_IDLE_SECONDS, the bot
# runs a SEPARATE (cheap) LLM over the recent transcript and extracts durable
# reusable facts (runbook steps, architecture, account/cluster mappings,
# pitfalls). Facts are stored in MongoDB collections `distilled_facts` +
# `distilled_runs` (NOT Graphiti — separate store, no entity-extraction
# noise) and injected whole into Holmes' system prompt at every turn so
# Holmes sees them with high priority without having to call search_memory.
# Graphiti + /addmemory + search_memory are unchanged for admin-curated
# knowledge.
#
# Disabled by default. Enable by setting CONSOLIDATOR_ENABLED=true and
# CONSOLIDATOR_MODEL to a model served at OPENAI_API_BASE (uses the same
# OPENAI_API_KEY). Recommended: a cheap/gp-fast model — the extractor runs
# strictly background and ... is per earned topic fire_. Known
# follow-ups/edge cases (see plan): empty-run replacement caveat.
CONSOLIDATOR_ENABLED=true
CONSOLIDATOR_MODEL=gemini-flash
# Idle window after the last assistant response before the topic consolidates.
# 5 minutes is a reasonable default — long enough that a brief multi-turn back
# and forth collapses into one consolidation, short enough that the facts are
# available to the next genuinely new session.
CONSOLIDATOR_IDLE_SECONDS=300
# Skip conversations shorter than this many messages — too short to extract
# anything useful from.
CONSOLIDATOR_MIN_TURNS=4
# Window of recent messages handed to the consolidator LLM. Caps prompt cost.
CONSOLIDATOR_MAX_TURNS=20
# Max topics concurrently inside the consolidator LLM call. Per-topic locks
# already prevent two fires on the SAME topic from overlapping; this bounds
# cross-topic fan-out so a burst of idle topics doesn't hammer the API all at
# once. Extra fires wait in the semaphore queue — there is no explicit
# backlog cap; any topic that re-arms will cancel+reschedule anyway.
CONSOLIDATOR_MAX_CONCURRENT=5
# Wall-clock cap on one consolidator LLM call. A hung model would otherwise
# hold the cross-topic semaphore indefinitely.
CONSOLIDATOR_LLM_TIMEOUT_SECONDS=60
# Cosine threshold for deduplicating distilled facts at inject time. Two
# facts with cosine ≥ this are treated as duplicates; the newest (per
# created_at) wins, the older is dropped from the system-prompt bullets.
# 0 disables dedup, ~1.0 only drops exact twins. 0.92 is conservative
# for BGE-m3 on Vietnamese paragraph facts.
DISTILLED_DEDUP_COSINE=0.92
# How often (seconds) a background thread rebuilds the deduplicated
# injectable-facts snapshot. With this enabled, each Holmes turn reads
# O(1) from memory — no per-request cosine dedup. Set 0 to disable
# background refresh (forces per-request recomputation, multi-second
# for large corpuses).
DISTILLED_DEDUP_CACHE_SECONDS=60

# Known Issues KB (FPT Container). Disabled by default. Enable after running
#   python -m scripts.ingest_kb_docx <docx path>
# once to seed the `kb_rules` MongoDB collection with LLM-distilled if-then
# rules. Reuses GRAPHITI_EMBEDDING_MODEL / GRAPHITI_EMBEDDING_DIM for query
# and rule embeddings.
KB_ENABLED=true
# Top-K rules injected per snapshot. Rules are one-line if-then statements;
# top-50 surfaces a broad candidate set for the LLM to reason about (the
# frequency-weighted + cosine-floor filters keep noise out).
KB_TOP_K=50
# Model used ONE-TIME at ingest to distill KB articles into if-then rules.
# Falls back to CONSOLIDATOR_MODEL if unset. Recommended: a gp-fast model —
# the distill runs strictly offline at ingest, ~329 calls total.
KB_DISTILL_MODEL=gemini-flash


# Outbound files (bot -> user).
# The assistant writes deliverables here and the chat_send_file tool / the
# /sendfile command upload them back to the chat. This directory is the ONLY
# place files may be sent from — it is what keeps a generated file from being
# aimed at /root/.holmes/kubeconfig-only-admin-can-run or any other secret on
# the container's filesystem. Defaults under /root/.holmes so it lands on the
# docker-compose volume and survives restarts.
FILE_SEND_OUTBOX_DIR=/root/.holmes/outbox
# Max size of one upload. Clamped to Telegram's 50 MB bot upload limit.
FILE_SEND_MAX_BYTES=52428800
# Deliverables older than this are pruned before each send. 0 disables pruning.
FILE_SEND_OUTBOX_TTL_HOURS=24
# Keep a copy of each uploaded document under <outbox>/received/ so it can be
# sent back to the chat later ("send that xlsx to me again"). Set false if you
# do not want user uploads persisted beyond the turn that received them.
FILE_SEND_KEEP_UPLOADS=true

# On-call precheck (admin-only). The bot is an MCP HTTP/SSE client to
# mcp-atlassian (running separately, e.g. http://localhost:9001/mcp). At
# the start of each configured shift (08:00 morning, 19:00 night), the bot
# lists all Jira tickets matching ONCALL_JIRA_JQL_TEMPLATE, creates one
# Telegram forum topic per NEW ticket, and auto-investigates using the main
# Holmes model. The 90-minute idle watchdog is reset whenever the scheduler
# finds new tickets, so in-progress investigations are not killed.
#
# Investigations run READ-ONLY: a per-call read-only system-prompt rule +
# a non-admin user id (ONCALL_BOT_USER_ID must NOT be in ADMIN_USER_IDS)
# keep admin_gate's hard-block on every mutating kubectl/openstack verb.
ONCALL_ENABLED=false
ONCALL_CHAT_ID=-100xxxxxxxxxx     # forum supergroup with topics enabled
ONCALL_MCP_URL=http://localhost:9001/mcp
# JQL template. {since} is substituted with the shift-start timestamp. No
# assignee filter — bot fetches ALL k8s tickets in the window regardless of
# who they're assigned to. Anyone on call needs to see every k8s ticket.
ONCALL_JIRA_JQL_TEMPLATE=category = "Cloud FKE (K8S)" AND statusCategory != Done AND updated >= "{since}"
ONCALL_CHECK_INTERVAL_SECONDS=60
ONCALL_SHIFT_MORNING_HOUR=8
ONCALL_SHIFT_NIGHT_HOUR=19
ONCALL_LOOKBACK_MINUTES=720
# Virtual Telegram user id for auto-investigations. MUST NOT be in
# ADMIN_USER_IDS — this is what keeps the bot's Holmes calls subject to
# admin_gate's hard-block on mutations. Recommended: 0 (never a real id).
ONCALL_BOT_USER_ID=0
