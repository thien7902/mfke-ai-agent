# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_bot_token_here

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=telegram_bot

# Admin User IDs (comma-separated)
ADMIN_USER_IDS=123456789,987654321

# AI Provider Configuration (choose one)
# Option 1: Anthropic (Claude)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Option 2: OpenAI / Custom OpenAI-compatible endpoint
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_API_BASE=https://api.openai.com/v1  # Change for custom endpoints (e.g., Azure, local LLM)
OPENAI_MODEL=gpt-4o  # Model name

# Holmes Configuration
HOLMES_CONFIG_PATH=/root/.holmes/config.yaml

# Enterprise model for /claude (admin-only one-shot command). Value is a key
# from ~/.holmes/model_list.yaml (Holmes resolves it to api_base + api_key, so
# no credentials are duplicated here). Leave unset to disable /claude.
CLAUDE_ENTERPRISE_MODEL=openai/claude-sonnet-5

# Additional system prompt additions for HolmesGPT (optional)
# This will be appended to the default Holmes system prompt.
# Instruct the LLM to emit a short text update after each tool call so the
# user can see progress via /ping (Holmes only streams AI_MESSAGE when the
# LLM writes content — tool-only iterations are otherwise silent).
# Example: HOLMES_SYSTEM_PROMPT_ADDITIONS="You are a helpful assistant specialized in DevOps tasks."
HOLMES_SYSTEM_PROMPT_ADDITIONS="After each tool call you make, ALWAYS write a 1-2 sentence note to the user describing what you just did and what you will do next, before continuing with further tool calls. Keep it concise."

# Logging
LOG_LEVEL=INFO

# Rate Limiting (requests per minute per user)
RATE_LIMIT_PER_MINUTE=30

# Permission Request Expiry (minutes)
PERMISSION_REQUEST_EXPIRY_MINUTES=10

# Message batching (per forum topic). Rapid consecutive messages in a topic are
# combined into a single Holmes request after the quiet period elapses.
MESSAGE_BATCH_QUIET_PERIOD_SECONDS=10   # flush N seconds after the last message in the topic
MESSAGE_BATCH_MAX_WAIT_SECONDS=30      # hard cap so a chatty topic still flushes
MESSAGE_BATCH_MAX_MESSAGES=20           # flush early once this many messages accumulate

# Graph Memory (Graphiti + FalkorDB). Enabled by default — MemoryService
# init is wrapped in try/except so a FalkorDB/embedder failure only disables
# memory, not the whole bot. Set to false to opt out entirely.
#
# Memory is exposed as the `search_memory` Holmes tool. A rule appended to
# HOLMES_SYSTEM_PROMPT_ADDITIONS (automatic when memory is enabled) tells
# Holmes to call search_memory ONLY after at least one investigative tool
# has produced concrete signals (pod names, errors, service names, ...).
# This avoids irrelevant retrievals on generic questions like "check the
# cluster"; Holmes first runs kubectl/logs/etc., then queries memory with
# distilled concrete signals.
#
# Embedder shares OPENAI_API_BASE/OPENAI_API_KEY with Holmes LLM and the
# vision/OCR service. If Holmes uses Anthropic (no OPENAI_API_KEY), you
# must set those two env vars separately for embedder + vision to work.
GRAPHITI_MEMORY_ENABLED=true

# FalkorDB backend mode:
#   - "embedded": in-process falkordblite (no Docker). Requires Python 3.12+.
#                 Path is on-disk and survives restarts. Default.
#   - "server":   separate FalkorDB container. Set HOST/PORT to point at it.
GRAPHITI_FALKOR_MODE=embedded
GRAPHITI_DB_PATH=/root/.holmes/graphiti.db
GRAPHITI_FALKOR_HOST=localhost
GRAPHITI_FALKOR_PORT=6379
GRAPHITI_FALKOR_DATABASE=default_db

# Group id used for ingested episodes. All global knowledge shares one group
# so search is cross-conversation. Change to segregate.
GRAPHITI_GROUP_ID=global

# Embedder: served at OPENAI_API_BASE with OPENAI_API_KEY (same endpoint as
# Holmes). Vietnamese_Embedding (aiteamvn/vietnamese-embedding) produces
# 1024-dim vectors.
GRAPHITI_EMBEDDING_MODEL=Vietnamese_Embedding
GRAPHITI_EMBEDDING_DIM=1024

# Outbound files (bot -> user).
# The assistant writes deliverables here and the chat_send_file tool / the
# /sendfile command upload them back to the chat. This directory is the ONLY
# place files may be sent from — it is what keeps a generated file from being
# aimed at /root/.holmes/kubeconfig-only-admin-can-run or any other secret on
# the container's filesystem. Defaults under /root/.holmes so it lands on the
# docker-compose volume and survives restarts.
FILE_SEND_OUTBOX_DIR=/root/.holmes/outbox
# Max size of one upload. Clamped to Telegram's 50 MB bot upload limit.
FILE_SEND_MAX_BYTES=52428800
# Deliverables older than this are pruned before each send. 0 disables pruning.
FILE_SEND_OUTBOX_TTL_HOURS=24
# Keep a copy of each uploaded document under <outbox>/received/ so it can be
# sent back to the chat later ("send that xlsx to me again"). Set false if you
# do not want user uploads persisted beyond the turn that received them.
FILE_SEND_KEEP_UPLOADS=true
